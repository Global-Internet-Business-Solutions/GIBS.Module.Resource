@using GIBS.Module.Resource.Services
@using ReservationModel = GIBS.Module.Resource.Models.Reservation
@using GIBS.Module.Resource.Models

@namespace GIBS.Module.Resource
@inherits ModuleBase
@inject IReservationService ClientReservationService
@inject IResourceService ClientResourceService

<div class="mb-3 d-flex justify-content-between">
    <ActionLink Action="BackOffice" Security="SecurityAccessLevel.View" Text="Return to BackOffice" />
    <NavLink class="btn btn-outline-secondary" href="@NavigateUrl()">Back to Calendar</NavLink>
</div>

@if (_Reservations == null)
{
    <p><em>Loading...</em></p>
}
else
{
    @if (_Reservations.Count != 0)
    {
        <Pager Items="@_Reservations" PageSize="10" SearchProperties="ResourceName,UserName,Status,StartTime,EndTime" Class="table table-striped" CurrentPage="@_currentPage" OnPageChange="@((int page) => { _currentPage = page.ToString(); })">
            <Header>
                <th>Resource</th>
                <th>User</th>
                <th>Start</th>
                <th>End</th>
                <th>Notes</th>
                <th>Status</th>
                <th>Actions</th>
            </Header>
            <Row>
                <td>@GetResourceName(context.ResourceId)</td>
                <td>@(context.UserId > 0 ? context.UserName : context.UserId.ToString())</td>
                <td>@AsLocalTime(context.StartTime).ToString("g")</td>
                <td>@AsLocalTime(context.EndTime).ToString("g")</td>
                <td>@context.Notes</td>
                <td>
                    <span class="badge @GetStatusBadgeClass(context.Status)">
                        @context.Status
                    </span>
                </td>
                <td>
                    <button type="button" class="btn btn-sm btn-warning me-1" @onclick="(() => EditReservation(context))">Edit</button>
                    @if (context.Status == ReservationStatus.Pending)
                    {
                        <button type="button" class="btn btn-sm btn-success me-1" @onclick="(() => ConfirmReservation(context))">Confirm</button>
                    }
                    <button type="button" class="btn btn-sm btn-danger" @onclick="(() => DeleteReservation(context.ReservationId))">Delete</button>
                </td>
            </Row>
        </Pager>
    }
    else
    {
        <p>No reservations found.</p>
    }
}

@if (_ShowEditDialog)
{
    <div class="modal show d-block" role="dialog" style="background-color: rgba(0,0,0,.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Edit Reservation</h5>
                    <button type="button" class="btn-close" @onclick="CloseEditDialog"></button>
                </div>
                <div class="modal-body">
                    @if (_EditingReservation != null)
                    {
                        <div class="mb-3">
                            <label class="form-label">User</label>
                            <input type="text" class="form-control" value="@GetReservationUserDisplay(_EditingReservation)" readonly />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Status</label>
                            <select class="form-select" @bind="_EditingReservation.Status">
                                @foreach (var status in Enum.GetValues<ReservationStatus>())
                                {
                                    <option value="@status">@status</option>
                                }
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Start Time</label>
                            <input type="datetime-local" class="form-control" @bind="_EditingReservation.StartTime" readonly />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">End Time</label>
                            <input type="datetime-local" class="form-control" @bind="_EditingReservation.EndTime" readonly />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Notes</label>
                            <textarea class="form-control" @bind="_EditingReservation.Notes"></textarea>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseEditDialog">Cancel</button>
                    <button type="button" class="btn btn-primary" @onclick="SaveReservation">Save</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    public override SecurityAccessLevel SecurityAccessLevel => SecurityAccessLevel.Edit;
    public override bool UseAdminContainer => false;

    public override string Actions => "ManageAllReservations";

    public override string Title => "Manage Reservations";

    public override List<Oqtane.Models.Resource> Resources => new List<Oqtane.Models.Resource>()
    {
        new Stylesheet("_content/GIBS.Module.Resource/Module.css"),
        new Script("_content/GIBS.Module.Resource/Module.js")
    };

    List<ReservationModel> _Reservations;
    List<Models.Resource> _Resources;
    ReservationModel _EditingReservation;
    bool _ShowEditDialog = false;
    string _currentPage = "1";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadReservationsAsync();
            _Resources = await ClientResourceService.GetResourcesAsync(ModuleState.ModuleId);
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Loading Reservations {Error}", ex.Message);
            AddModuleMessage("Error loading reservations data.", MessageType.Error);
        }
    }

    private async Task LoadReservationsAsync()
    {
        try
        {
            var reservations = new List<ReservationModel>();
            var resources = await ClientResourceService.GetResourcesAsync(ModuleState.ModuleId);

            foreach (var resource in resources)
            {
                var resourceReservations = await ClientReservationService.GetReservationsAsync(resource.ResourceId, ModuleState.ModuleId);
                if (resourceReservations != null)
                {
                    reservations.AddRange(resourceReservations);
                }
            }

            // Sort by StartTime descending
            _Reservations = reservations.OrderByDescending(r => r.StartTime).ToList();
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Loading All Reservations {Error}", ex.Message);
            AddModuleMessage("Error loading reservations.", MessageType.Error);
        }
    }

    private string GetResourceName(int resourceId)
    {
        return _Resources?.FirstOrDefault(r => r.ResourceId == resourceId)?.Name ?? "Unknown";
    }

    private string GetStatusBadgeClass(ReservationStatus status)
    {
        return status switch
        {
            ReservationStatus.Pending => "bg-warning",
            ReservationStatus.Confirmed => "bg-success",
            ReservationStatus.Cancelled => "bg-danger",
            _ => "bg-secondary"
        };
    }

    private string GetReservationUserDisplay(ReservationModel reservation)
    {
        if (reservation == null)
        {
            return string.Empty;
        }

        var userName = string.IsNullOrWhiteSpace(reservation.UserName) ? "Unknown" : reservation.UserName;
        return $"{userName} (UserId: {reservation.UserId})";
    }

    private void EditReservation(ReservationModel reservation)
    {
        _EditingReservation = new ReservationModel
        {
            ReservationId = reservation.ReservationId,
            ResourceId = reservation.ResourceId,
            UserId = reservation.UserId,
            UserName = reservation.UserName,
            StartTime = AsLocalTime(reservation.StartTime),
            EndTime = AsLocalTime(reservation.EndTime),
            Status = reservation.Status,
            Notes = reservation.Notes,
            OptIn = reservation.OptIn
        };
        _ShowEditDialog = true;
    }

    private void CloseEditDialog()
    {
        _ShowEditDialog = false;
        _EditingReservation = null;
    }

    private async Task SaveReservation()
    {
        try
        {
            if (_EditingReservation != null)
            {
                _EditingReservation.StartTime = AsUtcForSave(_EditingReservation.StartTime);
                _EditingReservation.EndTime = AsUtcForSave(_EditingReservation.EndTime);
                await ClientReservationService.UpdateReservationAsync(_EditingReservation, ModuleState.ModuleId);
                await logger.LogInformation("Reservation Updated {Reservation}", _EditingReservation);
                CloseEditDialog();
                await LoadReservationsAsync();
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Updating Reservation {Error}", ex.Message);
            AddModuleMessage("Error saving reservation.", MessageType.Error);
        }
    }

    private async Task ConfirmReservation(ReservationModel reservation)
    {
        try
        {
            reservation.Status = ReservationStatus.Confirmed;
            reservation.StartTime = AsUtcKind(reservation.StartTime);
            reservation.EndTime = AsUtcKind(reservation.EndTime);
            await ClientReservationService.UpdateReservationAsync(reservation, ModuleState.ModuleId);
            await logger.LogInformation("Reservation Confirmed {Reservation}", reservation);

            var existingReservation = _Reservations?.FirstOrDefault(r => r.ReservationId == reservation.ReservationId);
            if (existingReservation != null)
            {
                existingReservation.Status = ReservationStatus.Confirmed;
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Confirming Reservation {Error}", ex.Message);
            AddModuleMessage("Error confirming reservation.", MessageType.Error);
        }
    }

    private async Task DeleteReservation(int reservationId)
    {
        try
        {
            await ClientReservationService.DeleteReservationAsync(reservationId, ModuleState.ModuleId);
            await logger.LogInformation("Reservation Deleted {ReservationId}", reservationId);
            await LoadReservationsAsync();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Deleting Reservation {Error}", ex.Message);
            AddModuleMessage("Error deleting reservation.", MessageType.Error);
        }
    }

    private static DateTime AsLocalTime(DateTime value)
    {
        var utcValue = value.Kind == DateTimeKind.Unspecified
            ? DateTime.SpecifyKind(value, DateTimeKind.Utc)
            : value.ToUniversalTime();

        return utcValue.ToLocalTime();
    }

    private static DateTime AsUtcForSave(DateTime value)
    {
        var localValue = value.Kind == DateTimeKind.Unspecified
            ? DateTime.SpecifyKind(value, DateTimeKind.Local)
            : value;

        return localValue.ToUniversalTime();
    }

    private static DateTime AsUtcKind(DateTime value)
    {
        return value.Kind switch
        {
            DateTimeKind.Utc => value,
            DateTimeKind.Local => value.ToUniversalTime(),
            _ => DateTime.SpecifyKind(value, DateTimeKind.Utc)
        };
    }
}
